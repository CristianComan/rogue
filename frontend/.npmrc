# openapi-typescript's peerDependencies still pin typescript "^5.x"; the Vite
# react-ts scaffold ships TypeScript 6.x. legacy-peer-deps avoids fighting that
# lag on every install. Revisit once openapi-typescript widens its range.
legacy-peer-deps=true

# Vite 8/rolldown needs Node 20+ (util.styleText); this system also has an
# older Node on PATH depending on shell setup. Makes `npm install`/`ci` hard
# fail on the wrong Node instead of a scrollable EBADENGINE warning wall —
# npm doesn't re-check engines on `npm run`, so this only catches it at
# install time; `dev.sh`/`nvm use` (see .nvmrc) still matter for `npm run dev`.
engine-strict=true
